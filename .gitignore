.env
__pycache__/
*.pyc
*.pyo
last_picks.json
last_picks_s2.json
last_picks_s3.json
trades_log.json
.DS_Store

# Runtime state — regenerated by the bot, not source
position_peaks.json
raanu.db*
server_run.log
*.log

# Backtest artifacts — signal caches and reports are large and regenerable
backtest_reports/*.json

# Android signing key — never commit
twa/android.keystore
twa/*.keystore

# TWA build outputs and generated Android project. The AAB is rebuilt from
# twa-manifest.json, and the gradle project is 100% generated by bubblewrap.
twa/*.aab
twa/*.apk
twa/app/
twa/gradle/
twa/gradlew
twa/gradlew.bat
twa/build.gradle
twa/settings.gradle
twa/gradle.properties
twa/.gradle/
twa/manifest-checksum.txt
