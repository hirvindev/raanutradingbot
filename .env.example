
# ── Alpaca (paper trading + market data) ────────────────────────────────────
# Get keys at: https://app.alpaca.markets → API Keys
# Use "paper" keys and set ALPACA_MODE=paper for demo trading
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_MODE=paper                       # paper | live

# ── Twilio — WhatsApp alerts & commands ─────────────────────────────────────
# Sign up at https://twilio.com → Console → Messaging → Try WhatsApp Sandbox
# 1. Note your Account SID and Auth Token from the console home page
# 2. In Twilio sandbox, join with the code they give you (e.g. "join bright-fox")
# 3. Set webhook URL in sandbox settings: https://your-server.ngrok.io/webhook/whatsapp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox number (default)
USER_WHATSAPP=whatsapp:+919176911755         # Your WhatsApp number (with country code)

# ── Trading parameters ───────────────────────────────────────────────────────
# ── Exit rules ───────────────────────────────────────────────────────────────
# STOP_MODE=atr scales the stop to the stock's own daily range. A fixed % stop
# sits INSIDE the daily range of a volatile name and exits on noise: with the
# old 3% stop, 70% of all exits were stop-outs at a median hold of 2.1 days.
STOP_MODE=atr                # atr | pct
STOP_ATR_MULT_S1=2.5         # S1 pullbacks — backtested best
STOP_ATR_MULT_S2=3.0         # S2 breakouts need more room to hold the retest
STOP_ATR_MULT=2.5            # fallback for untagged positions
STOP_MIN_PCT=1.5             # floor — quiet ETFs would otherwise stop inside the spread
STOP_MAX_PCT=25.0            # ceiling — caps the stop on extreme-ATR names
STOP_LOSS_PCT=3.0            # only used when STOP_MODE=pct

TRAIL_MODE=atr               # atr | pct | off
TRAIL_ACTIVATE_ATR=2.0       # arm the trail once up this many ATR
TRAIL_ATR_MULT=1.5           # exit on giving back this many ATR from the peak
TRAIL_MIN_PCT=3.0            # floor on the give-back — book if it falls 3% from the high
TRAIL_ACTIVATE_MIN_PCT=2.5   # floor on the arm threshold

# Profit ladder — books progressively more the higher the trade runs.
# "peak:lock" pairs: once PEAK gain hits X%, never give back below +Y%.
# The floor only ratchets up. Runs alongside the trail; first to fire exits.
# Empty string disables it.
PROFIT_LADDER=5:2,10:6,15:11,20:15,30:24
TRAIL_ACTIVATE_PCT=5.0       # used when TRAIL_MODE=pct
TRAIL_PCT=2.5                # used when TRAIL_MODE=pct
HARD_TAKE_PROFIT_PCT=0       # Optional hard take-profit ceiling; 0 = disabled (let trail ride)
TAKE_PROFIT_PCT=5.0          # Legacy — only used as the fallback for TRAIL_ACTIVATE_PCT
DAILY_CRASH_PCT=8.0          # exit on a single-session drop this large

# ── Position sizing (Kelly) ──────────────────────────────────────────────────
# Size so the loss AT THE STOP is a fixed share of equity, so a wide-stop name
# gets a small position automatically. The risk share comes from Quarter Kelly
# on the strategy's own realized history.
KELLY_FRACTION=0.25          # 0.25 = Quarter Kelly, 0.5 = Half, 1.0 = Full
KELLY_MIN_SAMPLE=30          # below this many closed trades, use the fallback
KELLY_FALLBACK_RISK_PCT=0.5  # % of equity risked per trade while the sample is thin
KELLY_MAX_RISK_PCT=2.0       # hard ceiling on per-trade risk
MAX_POSITION_PCT=10.0        # cap any single position at this % of equity
PROFIT_CHECK_SEC=300         # Check positions every N seconds (default 5 min)
WEEKLY_TRADE_LIMIT=2         # Max trades in any rolling 7-day window
PER_TRADE_MAX_USD=500        # Max USD per trade
MIN_SIGNAL_SCORE=60          # Minimum score (0-100) to execute a trade
SCAN_INTERVAL_SEC=1800       # Scan frequency in seconds (default 30 min)
