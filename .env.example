# Copy this file to ".env" (without the .example) and fill in your values.

# Get this from Trade 212:
#   1. Open the T212 mobile app or web app
#   2. Settings -> API (Beta) -> Generate API Key
#   3. NOTE: API access is enabled per-account. If you don't see the API option,
#      email support and request API access for your Practice account first.
T212_API_KEY=

# Either "demo" (Practice account, fake money) or "live" (real money).
# ALWAYS start with demo until you trust the system.
T212_MODE=demo

# ----- Auto-trader limits (hard-enforced, can't be exceeded) -----
WEEKLY_TRADE_LIMIT=2
PER_TRADE_MAX_EUR=500
MIN_SIGNAL_SCORE=60
SCAN_INTERVAL_SEC=1800
WATCHLIST=AAPL,MSFT,NVDA,GOOGL,AMZN,META,AMD,TSLA
