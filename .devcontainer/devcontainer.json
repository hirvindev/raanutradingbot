{
  "name": "raanutradingbot-aws",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Node is here only because the CDK CLI ships via npm — the CLI version
  // itself is NOT installed by a feature, on purpose: aws/package.json
  // already pins it (`npx cdk`), so pulling in a second, unpinned copy here
  // would reintroduce the exact CLI/aws-cdk-lib version-skew problem that
  // pin was written to avoid. postCreateCommand runs `npm install` to
  // provision the pinned version instead.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Bind mount, not a copy: the container reads your host's already-
  // configured AWS credentials (static keys or SSO cache, either works)
  // live. Nothing is ever baked into the image or committed. Run
  // `aws configure` (or SSO login) on the host at least once first so
  // ~/.aws exists before the container starts.
  "mounts": [
    "source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached"
  ],

  "remoteEnv": {
    "AWS_REGION": "eu-central-1",
    "AWS_DEFAULT_REGION": "eu-central-1"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "amazonwebservices.aws-toolkit-vscode",
        "redhat.vscode-yaml"
      ]
    }
  }
}
